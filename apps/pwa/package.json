{
  "name": "@opencode-dispatch/pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "audit:lighthouse": "bun run build && bun run scripts/audit-lighthouse.ts",
    "test": "bun run test:unit && bun run test:components && bun run test:e2e",
    "test:components": "vitest run --config vitest.config.ts",
    "test:unit": "bun test tests/*.test.ts",
    "test:e2e": "playwright test && bun run scripts/sanitize-playwright-report.ts"
  },
  "dependencies": {
    "@kobalte/core": "0.13.12",
    "@opencode-dispatch/contracts": "workspace:*",
    "@solidjs/router": "1.0.0",
    "phosphor-solid": "1.1.5",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@solidjs/testing-library": "0.8.10",
    "@vite-pwa/assets-generator": "1.0.2",
    "chrome-launcher": "1.2.1",
    "happy-dom": "20.11.1",
    "lighthouse": "13.4.1",
    "playwright-lighthouse": "4.0.0",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.10",
    "workbox-window": "7.4.1"
  }
}
